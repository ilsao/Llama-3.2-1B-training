% Cerulean Labs internal research report style.
% Derived from the final-format typography and spacing of the NeurIPS 2026
% template, with all submission, review, anonymization, and preprint branches
% removed.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cerulean_report}[2026-09-22 Cerulean Labs research report style]

\RequirePackage{graphicx}
\RequirePackage{natbib}
\RequirePackage[verbose=true,letterpaper]{geometry}
\RequirePackage{fancyhdr}

% Report identity. These may be overridden in the document preamble.
\newcommand{\@reporttype}{Research Report}
\newcommand{\reporttype}[1]{\renewcommand{\@reporttype}{#1}}
\newcommand{\@reportlogo}{assets/cerulean-logo.png}
\newcommand{\reportlogo}[1]{\renewcommand{\@reportlogo}{#1}}

% Original final-format NeurIPS typography: PSNFSS Times and Helvetica.
% Overleaf Community Edition installations need the TeX Live packages
% `psnfss`, `times`, and `helvetic`; see OVERLEAF_COMMUNITY_EDITION.md.
\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}

\AtBeginDocument{%
  \newgeometry{
    textheight=9in,
    textwidth=5.5in,
    top=1in,
    headheight=22pt,
    headsep=22pt,
    footskip=30pt
  }%
  \@ifpackageloaded{hyperref}{\hypersetup{hidelinks}}{}%
  \pagestyle{ceruleanreport}%
}

\widowpenalty=10000
\clubpenalty=10000
\flushbottom
\sloppy

% Font sizes and display spacing. Use explicit point dimensions here instead of
% LaTeX's internal size macros so the style works across TeX Live releases,
% including the older releases commonly offered by Overleaf.
\renewcommand{\normalsize}{%
  \@setfontsize\normalsize{10pt}{11pt}%
  \abovedisplayskip      7\p@ \@plus 2\p@ \@minus 5\p@
  \abovedisplayshortskip \z@ \@plus 3\p@
  \belowdisplayskip      \abovedisplayskip
  \belowdisplayshortskip 4\p@ \@plus 3\p@ \@minus 3\p@
}
\normalsize
\renewcommand{\small}{%
  \@setfontsize\small{9pt}{10pt}%
  \abovedisplayskip      6\p@ \@plus 1.5\p@ \@minus 4\p@
  \abovedisplayshortskip \z@ \@plus 2\p@
  \belowdisplayskip      \abovedisplayskip
  \belowdisplayshortskip 3\p@ \@plus 2\p@ \@minus 2\p@
}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize{8pt}{9.5pt}}
\renewcommand{\scriptsize}{\@setfontsize\scriptsize{7pt}{8pt}}
\renewcommand{\tiny}{\@setfontsize\tiny{6pt}{7pt}}
\renewcommand{\large}{\@setfontsize\large{12pt}{14pt}}
\renewcommand{\Large}{\@setfontsize\Large{14pt}{16pt}}
\renewcommand{\LARGE}{\@setfontsize\LARGE{17pt}{20pt}}
\renewcommand{\huge}{\@setfontsize\huge{20pt}{23pt}}
\renewcommand{\Huge}{\@setfontsize\Huge{25pt}{28pt}}

% Section hierarchy.
\providecommand{\section}{}
\renewcommand{\section}{%
  \@startsection{section}{1}{\z@}%
                {-2.0ex \@plus -0.5ex \@minus -0.2ex}%
                { 1.5ex \@plus  0.3ex \@minus  0.2ex}%
                {\large\bfseries\raggedright}%
}
\providecommand{\subsection}{}
\renewcommand{\subsection}{%
  \@startsection{subsection}{2}{\z@}%
                {-1.8ex \@plus -0.5ex \@minus -0.2ex}%
                { 0.8ex \@plus  0.2ex}%
                {\normalsize\bfseries\raggedright}%
}
\providecommand{\subsubsection}{}
\renewcommand{\subsubsection}{%
  \@startsection{subsubsection}{3}{\z@}%
                {-1.5ex \@plus -0.5ex \@minus -0.2ex}%
                { 0.5ex \@plus  0.2ex}%
                {\normalsize\bfseries\raggedright}%
}
\providecommand{\paragraph}{}
\renewcommand{\paragraph}{%
  \@startsection{paragraph}{4}{\z@}%
                {1.5ex \@plus 0.5ex \@minus 0.2ex}%
                {-1em}%
                {\normalsize\bfseries}%
}

% Paragraph, list, float, and footnote spacing.
\setlength{\parindent}{\z@}
\setlength{\parskip}{5.5\p@}
\setlength{\topsep}{4\p@ \@plus 1\p@ \@minus 2\p@}
\setlength{\partopsep}{1\p@ \@plus 0.5\p@ \@minus 0.5\p@}
\setlength{\itemsep}{2\p@ \@plus 1\p@ \@minus 0.5\p@}
\setlength{\parsep}{2\p@ \@plus 1\p@ \@minus 0.5\p@}
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.4}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.7}
\setlength{\abovecaptionskip}{7\p@}
\setlength{\belowcaptionskip}{\z@}
\setlength{\footnotesep}{6.65\p@}
\setlength{\skip\footins}{9\p@ \@plus 4\p@ \@minus 2\p@}
\renewcommand{\footnoterule}{\kern-3\p@ \hrule width 12pc \kern 2.6\p@}

% Muon-inspired running header. Muon uses the normal 10-point text size for
% the centered paper title and footnotesize for the right-hand report label.
% The header reads directly from \title so it always matches the paper heading.
\fancypagestyle{ceruleanreport}{%
  \fancyhf{}
  \fancyhead[C]{%
    \small
    \raisebox{-0.12\height}{\includegraphics[width=0.02\textwidth]{\@reportlogo}}%
    \hspace{0.45em}\@title
  }
  \fancyhead[R]{\footnotesize\scshape\@reporttype}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0pt}
}

% LaTeX switches float-only and some transition pages to the plain style.
% Keep the Cerulean running header on those pages as well.
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyhead[C]{%
    \small
    \raisebox{-0.12\height}{\includegraphics[width=0.02\textwidth]{\@reportlogo}}%
    \hspace{0.45em}\@title
  }
  \fancyhead[R]{\footnotesize\scshape\@reporttype}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0pt}
}

% Some forced-position floats use the empty style on the following page.
% Reserve a separate style for the title page, then keep the running header on
% any later page that LaTeX marks empty.
\fancypagestyle{ceruleanfirst}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}
\fancypagestyle{empty}{%
  \fancyhf{}
  \fancyhead[C]{%
    \small
    \raisebox{-0.12\height}{\includegraphics[width=0.02\textwidth]{\@reportlogo}}%
    \hspace{0.45em}\@title
  }
  \fancyhead[R]{\footnotesize\scshape\@reporttype}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0pt}
}

% Muon-inspired first-page title lockup.
\providecommand{\maketitle}{}
\renewcommand{\maketitle}{%
  \par
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}
    \thispagestyle{ceruleanfirst}
    \vbox{%
      \hsize\textwidth
      \linewidth\hsize
      \vskip 0.1in
      \hrule height 4\p@
      \vskip 0.25in
      \vskip -\parskip
      \centering
      \makebox[\textwidth][c]{%
        \raisebox{-0.18\height}{\includegraphics[height=0.28in]{\@reportlogo}}%
        \hspace{0.55em}{\LARGE\bfseries\@title}%
      }\par
      \vskip 0.29in
      \vskip -\parskip
      \hrule height 1\p@
      \vskip 0.09in
      {\large\scshape\@reporttype\par}
      \vskip 0.13in
      \def\And{%
        \end{tabular}\hfil\linebreak[0]\hfil
        \begin{tabular}[t]{c}\rule{\z@}{24\p@}\ignorespaces
      }%
      \def\AND{%
        \end{tabular}\hfil\linebreak[4]\hfil
        \begin{tabular}[t]{c}\rule{\z@}{24\p@}\ignorespaces
      }%
      \begin{tabular}[t]{c}\rule{\z@}{24\p@}\@author\end{tabular}
      \vskip 0.3in \@minus 0.1in
    }
    \@thanks
  \endgroup
  \setcounter{footnote}{0}
  \let\maketitle\relax
  \let\thanks\relax
}

% Abstract and acknowledgments are always visible in internal reports.
\renewenvironment{abstract}{%
  \vskip 0.075in
  \centerline{\large\bfseries Abstract}
  \vspace{0.5ex}
  \begin{quote}
}{%
  \par
  \end{quote}
  \vskip 1ex
}

\newenvironment{ack}{%
  \section*{Acknowledgments}
}{%
}

\endinput
